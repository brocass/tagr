pkgname=tagr
pkgver=0.4.2
pkgrel=7
pkgdesc='Native Omarchy audio tag editor'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'taglib' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'pkgconf')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/tagr "$pkgdir/usr/bin/tagr"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/tagr.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/tagr.svg"
  install -Dm644 "$startdir/tagr.desktop" "$pkgdir/usr/share/applications/tagr.desktop"
}
